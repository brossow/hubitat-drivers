# ── Printer (local LAN) ───────────────────────────────────────────────────────
BAMBU_IP=10.0.11.1
BAMBU_ACCESS_CODE=xxxxxxxx

# Printer serial number — visible in Bambu Studio (Device tab) or on the printer
# touchscreen. Looks like: 01P00C000000000
BAMBU_SERIAL=01P00C000000000

# ── Hubitat ───────────────────────────────────────────────────────────────────
# Full endpoint URL shown on the Bambu Bridge app page after installation.
# Example: http://192.168.1.50/apps/api/42/update?access_token=xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx
HUBITAT_URL=http://192.168.1.x/apps/api/APP_ID/update?access_token=YOUR_TOKEN

# ── Optional ──────────────────────────────────────────────────────────────────
# RECONNECT_DELAY=30       # seconds between reconnect attempts
# LOG_LEVEL=INFO           # DEBUG | INFO | WARNING | ERROR
